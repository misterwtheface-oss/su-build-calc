 "involves_rule": "An old Action/Mechanic tag that the new tags, Source and object_themes do not re-derive becomes Involves::<theme> with its old provenance. Theme = derived ∪ Involves. Each Involves tag is a review item: either a narrower tag is missing (add it) or the theme was wrong (drop it).",
 "attributes": {
  "scope": {
   "status": "RATIFIED 2026-10-18",
   "values": [
    "Self",
    "Ally",
    "Self or Ally",
    "Enemy",
    "Any",
    "Adjacent"
   ],
   "code": {
    "self": "Self",
    "ally": "Ally",
    "ally_or_self": "Self or Ally",
    "enemy": "Enemy",
    "any": "Any",
    "adjacent": "Adjacent"
   },
   "filter": "Filtering 'Ally side' matches Self, Ally and Self or Ally. 'Ally' alone means another ally, never the bearer."
  },
  "source": {
   "status": "RATIFIED 2026-10-18",
   "_note": "Second per-tag attribute (with scope). Which action a damage / hit / calculation tag applies to. Migrated from the object's existing code-grounded Action/Mechanic Attack / Cast / Indirect Damage tags; none = applies to any damage.",
   "values": [
    "Attack",
    "Spell",
    "Indirect"
   ],
   "applies_to": [
    "Damage::*",
    "Hit Resolution::*",
    "Calculation::*",
    "Trigger::Damage",
    "Actions::Turn Action Limit",
    "Trigger::DoT Tick",
    "Actions::Intercept",
    "Actions::Limit Repeats",
    "Condition::Has Done Action",
    "Buffs::Persist",
    "Debuffs::Persist",
    "Traits::Suppress",
    "Targeting::Target Rules",
    "Actions::Redirect",
    "Stat::*"
   ],
   "from_old": {
    "Action/Mechanic::Attack": "Attack",
    "Action/Mechanic::Cast": "Spell",
    "Action/Mechanic::Indirect Damage": "Indirect"
   },
   "themes": {
    "Attack": "Attack",
    "Spell": "Cast",
    "Indirect": "Indirect Damage"
   },
   "_theme_note": "Damage::Inflict + Spell (a trait's 'deals damage', dtype 1) derives Damage only, not Cast: spell-type damage outside a cast is not casting (2026-10-19).",
   "adds_damage": [
    "Damage::*",
    "Hit Resolution::*",
    "Calculation::*!DoT Formula",
    "Trigger::Damage"
   ],
   "_rule_note": "F5 Source rule fix (user 2026-10-21): a sourced tag adds its Source theme (Attack -> Attack, Spell -> Cast, Indirect -> Indirect Damage). Only tags in adds_damage also add Damage."
  },
  "role": {
   "status": "DRAFT",
   "applies_to": [
    "Trigger::*"
   ],
   "values": [
    "Performer",
    "Receiver",
    "Applier"
   ],
   "_note": "Performer = the creature doing the event (attacker, caster, damager, healer, killer); Receiver = the creature it happens to (attacked, damaged, healed, dying, debuffed); Applier = the creature that applies a buff/debuff. Code: holder_anchor / holder_rel and bc_EventDamage damager-damaged role."
  },
  "phase": {
   "status": "RATIFIED",
   "applies_to": [
    "Trigger::*"
   ],
   "values": [
    "Would",
    "During",
    "After",
    "Repeat",
    "Direct"
   ],
   "_note": "Would = hook inside the event (bc_Event*), before it resolves, and the effect issues something new or replaces it (\"when X would be debuffed\"). An in-event hook that only changes the number is an Effect, not a Trigger. After = reaction (bc_On*, start/end-of-turn, startup). Repeat = \"effects that activate when X activate N more times\" (bc_ExecuteEvents). During = a hook inside the creature's own bc_CreatureAttack / bc_CreatureCast that issues something before the action resolves (user 2026-10-19).",
   "code": {
    "Would": [
     "bc_EventBuff",
     "bc_EventDebuff",
     "bc_EventHeal",
     "bc_EventResurrect",
     "bc_EventGain*",
     "bc_EventLose*",
     "bc_EventDamage",
     "bc_CreatureCastRandomSpell"
    ],
    "After": [
     "bc_On*",
     "bc_CreatureStartOfTurn",
     "bc_CreatureEndOfTurn",
     "bc_Startup*"
    ],
    "Repeat": [
     "bc_ExecuteEvents"
    ],
    "During": [
     "bc_CreatureAttack",
     "bc_CreatureCast"
    ]
   },
   "_f5_note": "Direct (round 3 ratification): the handler is called directly and reactions do fire. Not the old delivery value."
  },
  "delivery": {
   "status": "RATIFIED",
   "applies_to": [
    "Stats::Gain",
    "Stats::Lose",
    "Buffs::Apply",
    "Debuffs::Apply",
    "Minions::Summon",
    "Life::Heal",
    "Life::Execute",
    "Actions::Auto Defend"
   ],
   "values": [
    "Event",
    "No Event"
   ],
   "_note": "Event = goes through the game event: reactions fire, diminishing returns and the per-turn action limit apply. Direct = written straight onto the creature: no reactions, no limit (immunity still checked). Ruled 2026-10-19 from extract Q1/Q2.",
   "code": {
    "Event": [
     "bc_EventGain*",
     "bc_EventLose*",
     "bc_EventBuff",
     "bc_EventDebuff"
    ],
    "Direct": [
     "bc_StartupStatGain",
     "bc_StartupStatLoss",
     "scr_CritAddCondition (bare)"
    ]
   },
   "_f5_note": "F5 round 4 ruling C (user 2026-10-21): Direct renamed No Event; applies_to + Minions::Summon, Life::Heal, Life::Execute, Actions::Auto Defend."
  }
 },
