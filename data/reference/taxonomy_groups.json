  { "name": "Defend & Provoke", "include": ["theme:Defend", "theme:Provoke"] },
  { "name": "Damage", "include": ["theme:Damage", "Involves::Indirect Damage", "Trigger::DoT Tick"] },
  { "name": "Health & Healing", "include": ["theme:Healing", "Condition::Health Threshold", "Scales With::Current Health %", "Scales With::Missing Health %"] },
  { "name": "Death & Resurrection", "include": ["theme:Resurrection", "Trigger::Death", "Life::Execute", "Life::Survive Lethal", "Condition::Is Dead", "Condition::Is Alive", "Scales With::Dead Creature Count", "Scales With::Living Creature Count"] },
  { "name": "Buffs", "include": ["theme:Buff"] },
  { "name": "Debuffs", "include": ["theme:Debuff"] },
  { "name": "Minions", "include": ["theme:Minion", "Trigger::Minion Lost"] },
  { "name": "Stats", "include": ["theme:Stats"] },
  { "name": "Turns & Timeline", "include": ["theme:Turn Counter", "theme:Timeline", "Trigger::Battle Start", "Trigger::Turn Start", "Trigger::Turn End", "Condition::Turn Number", "Condition::Not Their Turn", "Condition::Has Done Action", "Condition::Undamaged This Turn", "Scales With::Turn Count"] },
  { "name": "Traits", "include": ["Traits::*", "Trait Kind::*", "Trigger::Trait Activation", "Scales With::Traits Gained Count"] },
  { "name": "Class & Race", "include": ["theme:Creature Class", "theme:Creature Race", "Condition::Party All Same Type", "Condition::Is Type", "Scales With::Type Count"] },
  { "name": "Party & Targeting", "include": ["Targeting::*", "Condition::Creatures Missing", "Scales With::Missing Creature Count", "theme:Adjacency"] },
  { "name": "Equipment & Personality", "include": ["theme:Artifact", "theme:Relic", "theme:Personality"] }
 ]
